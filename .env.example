PORT=8787
HOST=127.0.0.1

# Inbound key accepted by this proxy as:
# Authorization: Bearer <MASTER_API_KEY>
MASTER_API_KEY=change-me

# Kiro API key generated in app.kiro.dev.
KIRO_API_KEY=ksk_xxx

# Default upstream model when the client omits "model".
KIRO_MODEL=claude-opus-4.7

# Optional overrides.
KIRO_CLI=/root/.local/bin/kiro-cli
REQUEST_TIMEOUT_MS=300000
